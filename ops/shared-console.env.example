# Shared Console systemd environment
#
# For quick public testing, set the API and web hosts to 0.0.0.0 and point
# SHARED_CONSOLE_API_BASE at the server's reachable address.
# The shared-console API currently has no auth layer, so do not expose it on a
# public network long-term without a reverse proxy, firewall, or access control.

SHARED_CONSOLE_API_HOST=0.0.0.0
SHARED_CONSOLE_API_PORT=43100
SHARED_CONSOLE_API_BASH=/bin/bash
SHARED_CONSOLE_API_INSTANCES_ROOT=/www/openclaw/shared-instances
SHARED_CONSOLE_API_DEDICATED_INSTANCES_ROOT=/www/openclaw/dedicated-instances
SHARED_CONSOLE_API_PROBE_TIMEOUT_MS=1500

OPENCLAW_CONTAINER_REPO_ROOT=/www/openclaw/repo
OPENCLAW_CONTAINER_SHARED_INSTANCES_ROOT=/www/openclaw/shared-instances
OPENCLAW_CONTAINER_DEDICATED_INSTANCES_ROOT=/www/openclaw/dedicated-instances

SHARED_CONSOLE_HOST=0.0.0.0
SHARED_CONSOLE_PORT=43101
SHARED_CONSOLE_API_BASE=http://223.254.144.141:43100
